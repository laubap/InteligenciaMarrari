// Mapa usado pelo subcomando "placar": quais tags cada falha do simulador CP300 deve afetar.
// Um alarme so conta como deteccao se cair numa tag listada aqui (e se a tag nao alarmava
// nos N minutos antes da falha; ver README, secao 6). Editavel: comentarios e virgula final sao aceitos.
//
// Tokens aceitos em "tags":
//   TAGnn            tag literal
//   ALVO.<campo>     tag da bomba atingida (campo de "bombas"). Alvo do slot (TAG62/66/70):
//                    1 = B-01, 2 = B-02, 0 = bomba principal no instante da injecao
//                    (valor de "tagBombaPrincipal" no ultimo minuto antes do inicio da falha).
//   OUTRA.<campo>    tag da outra bomba (reserva/auxiliar).
//   CANAL            falhas de sensor (20-27): canal k = alvo % 100 (+100 = sentido negativo).
//   *                todas as tags do replay (falhas de comunicacao).
// Rotulos (TAG60-TAG81) sao recusados como tag afetada.
//
// Fontes: Docs/CENARIOS_CP300.md (secoes 2 e 4) e o catalogo de falhas de
// Docs/Simulador/SIM_ANOMALIAS_CP300.c (codigos 05 e 11, que nao estao no CENARIOS).
{
  "tagBombaPrincipal": "TAG44",
  "tagAnomaliaAtiva": "TAG73",
  "slots": [
    { "nome": "A", "codigo": "TAG61", "alvo": "TAG62", "severidade": "TAG63", "fase": "TAG64" },
    { "nome": "B", "codigo": "TAG65", "alvo": "TAG66", "severidade": "TAG67", "fase": "TAG68" },
    { "nome": "C", "codigo": "TAG69", "alvo": "TAG70", "severidade": "TAG71", "fase": "TAG72" }
  ],
