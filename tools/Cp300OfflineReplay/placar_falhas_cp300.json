    "2": { "nome": "B-02", "corrente": "TAG28", "vibracao": "TAG30", "frequencia": "TAG32", "temperaturaEnrolamento": "TAG35", "temperaturaMancal": "TAG37" }
  },
  "canaisSensor": {
    "1": "TAG22", "2": "TAG23", "3": "TAG24", "4": "TAG25", "5": "TAG26", "6": "TAG27",
    "7": "TAG28", "8": "TAG29", "9": "TAG30", "10": "TAG31", "11": "TAG32", "12": "TAG33",
