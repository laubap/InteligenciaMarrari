            "tags": [ "ALVO.frequencia", "ALVO.corrente", "TAG33", "OUTRA.corrente", "OUTRA.vibracao", "OUTRA.frequencia" ] },
    "5":  { "nome": "Sobrecarga mecânica do motor", "origem": "catalogo do simulador (fora do CENARIOS; a confirmar)",
