<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\IAApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Benchmark\**\*.cs"
             Link="Benchmark\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Benchmark\oracle.json"
             Link="Benchmark\oracle.json"
             CopyToOutputDirectory="PreserveNewest" />

    <Content Include="..\..\Benchmark\TestData\MultivariateGroups.json"
             Link="Benchmark\TestData\MultivariateGroups.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\appsettings.json"
             Link="appsettings.json"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('..\..\appsettings.json')" />

    <Content Include="..\..\appsettings.Development.json"
             Link="appsettings.Development.json"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('..\..\appsettings.Development.json')" />
  </ItemGroup>

</Project>
