{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Bridge": {
    "BaseUrl": "http://localhost:5001",
    "HorasHistorico": 24
  },

  "AnomalyDetection": {
    "EnsembleThreshold": 60,
    "MinHistoryPoints": 30,

    "ZScoreWeight": 0.15,
    "MadWeight": 0.15,
    "EwmaWeight": 0.15,
    "RateOfChangeWeight": 0.10,
    "PersistenceWeight": 0.10,
    "LevelShiftWeight": 0.10,

    "ZScoreThreshold": 3.0,
    "MadThreshold": 3.5,

    "EwmaLambda": 0.25,
    "EwmaSigmaLimit": 3.0,

    "RateOfChangeThreshold": 3.5,

    "PersistenceMinimumPoints": 5,
    "PersistenceMinimumMinutes": 1,

    "LevelShiftPreviousWindow": 20,
    "LevelShiftRecentWindow": 10,
    "LevelShiftThreshold": 3.0,
    "LevelShiftMinimumConsistency": 0.80,

    "IsolationForest": {
      "Weight": 0.25,
      "TreeCount": 100,
      "SampleSize": 256,
      "MinimumHistoryPoints": 50,
      "FeatureWindowSize": 10,
      "AnomalyThreshold": 0.62,
      "RandomSeed": 42,
      "NormalizationSlope": 12
    }
  },

  "Llm": {
    "Habilitado": true,
    "BaseUrl": "http://10.0.1.99:1234/v1/",
    "model": "qwen/qwen3.6-35b-a3b",
    "Temperatura": 0.1,
    "TimeoutSegundos": 120,
    "KeepAlive": "10m"
  },

  "OpenAI": {
    "Modelo": "gpt-5-mini",
    "Habilitado": false
  },

  "AllowedHosts": "*"
}