# Build
bin/
obj/

# Banco SQLite local
*.db
*.db-wal
*.db-shm
*.db-journal

# Modelos treinados
ModelsML/

# CSVs gerados automaticamente
Data/*_enriquecido.csv

# Arquivos do Visual Studio
.vs/

# Resultados e artefatos locais
Results/
Artifacts/
db-backups/

# Ferramentas (tools/): o código é versionado.
# bin/ e obj/ já são ignorados pelas regras do topo, em qualquer pasta.
# node_modules/, dist/ e .env ficam no .gitignore de cada ferramenta (ex.: tools/IAApi.LiveMonitor/.gitignore).
tools/**/node_modules/
tools/**/dist/
tools/**/TestResults/
tools/**/*.log

# Dados exportados do Bridge/PSi4 (industriais, sensíveis) e resultados de teste, em qualquer pasta
dados/
TestResults/

# Checks/backups históricos
B319Check/
B32012ProcessCheck/
B3221_Backup/

# Backups manuais
*.bak
*.bak-*
*.before-*
